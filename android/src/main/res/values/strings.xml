    <string name="privacy_phone">On this phone</string>
    <string name="privacy_phone_body">Your passkeys are made and kept in this phone\'s secure hardware. They are never uploaded, synced, or backed up. fidont has no accounts, ads, or analytics.</string>
    <string name="privacy_relay">The relay</string>
    <string name="privacy_relay_body">When you scan a QR code, your phone and the computer talk through a relay at cable.ahhkeysummo2d.com. z1xus runs it behind Cloudflare. Everything they send is encrypted end to end, so nobody in between can read it or sign in as you. The relay and Cloudflare see your IP address and the time of the connection. The relay keeps no logs.</string>
    <string name="privacy_dongle">The dongle</string>
    <string name="privacy_dongle_body">The dongle holds no passkeys. It passes requests from the computer to your phone over an encrypted Bluetooth link.</string>
