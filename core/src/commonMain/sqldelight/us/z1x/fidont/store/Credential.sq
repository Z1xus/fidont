CREATE TABLE credential (
  id BLOB NOT NULL PRIMARY KEY,
  rpId TEXT NOT NULL,
  userId BLOB NOT NULL,
  userName TEXT NOT NULL,
  displayName TEXT NOT NULL,
  discoverable INTEGER AS kotlin.Boolean NOT NULL
);

all:
SELECT * FROM credential ORDER BY rpId, userName;

byId:
SELECT * FROM credential WHERE id = ?;

discoverable:
SELECT * FROM credential WHERE rpId = ? AND discoverable = 1 ORDER BY userName;

insert:
INSERT INTO credential VALUES ?;

delete:
DELETE FROM credential WHERE id = ?;
